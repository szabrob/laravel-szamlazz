{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "szabrob/laravel-szamlazz",
    "description": "Laravel integration for the Számlázz.hu Számla Agent API.",
    "keywords": [
        "laravel",
        "szamlazz",
        "szamlazz.hu",
        "szamla-agent",
        "invoice",
        "szamla",
        "szabrob"
    ],
    "homepage": "https://github.com/szabrob/laravel-szamlazz",
    "license": "MIT",
    "authors": [
        {
            "name": "Szabó Róbert",
            "email": "szaborobert995@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/szabrob/laravel-szamlazz/issues",
        "source": "https://github.com/szabrob/laravel-szamlazz",
        "security": "https://github.com/szabrob/laravel-szamlazz/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Szabrob\\LaravelSzamlazz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Szabrob\\LaravelSzamlazz\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Szabrob\\LaravelSzamlazz\\LaravelSzamlazzServiceProvider"
            ],
            "aliases": {
                "SzamlaAgent": "Szabrob\\LaravelSzamlazz\\Facades\\SzamlaAgent"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
